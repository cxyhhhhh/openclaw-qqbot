{
  "name": "@tencent-connect/openclaw-qqbot",
  "version": "2.0.0-alpha.1",
  "description": "QQ Bot channel plugin for OpenClaw",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "bin": {
    "openclaw-qqbot": "./bin/qqbot-cli.js",
    "qqbot": "./bin/qqbot-cli.js"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "skills",
    "scripts",
    "index.ts",
    "preload.cjs",
    "tsconfig.json",
    "tsup.config.ts",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "id": "openclaw-qqbot",
    "extensions": [
      "./preload.cjs"
    ],
    "channel": {
      "id": "qqbot",
      "label": "QQ Bot"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint:runtime": "npx tsx src/runtime-adapter/lint-runtime-access.ts",
    "prepack": "npm install --omit=dev",
    "postinstall": "node scripts/postinstall-link-sdk.js 2>/dev/null || true"
  },
  "dependencies": {
    "@tencent-connect/qqbot-nodejs": "npm:@tencent/qqbot-nodejs@0.0.0-dev.8a6be470",
    "@tencent-connect/qqbot-connector": "1.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@tencent-connect/qqbot-connector": "1.2.0",
    "openclaw": "*"
  },
  "homepage": "https://github.com/tencent-connect/openclaw-qqbot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tencent-connect/openclaw-qqbot.git"
  }
}
